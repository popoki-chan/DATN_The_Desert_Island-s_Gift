  tipText: {fileID: 0}
  spinner: {fileID: 0}
  fadeDuration: 0.4
  spinnerSpeed: 200
  tipCycleInterval: 3.5
  gameplayTips:
  - "B\u1EA1n c\xF3 th\u1EC3 d\xF9ng chu\u1ED9t tr\xE1i \u0111\u1EC3 t\u01B0\u01A1ng
    t\xE1c v\u1EDBi m\u1ECDi v\u1EADt th\u1EC3 tr\xEAn \u0111\u1EA3o hoang."
  - "H\xE3y quan s\xE1t th\u1EADt k\u1EF9 c\xE1c k\xFD t\u1EF1 l\u1EA1 tr\xEAn v\xE1ch
    \u0111\xE1, \u0111\xF3 c\xF3 th\u1EC3 l\xE0 ch\xECa kh\xF3a gi\u1EA3i \u0111\u1ED1."
  - "C\xE2u c\xE1 y\xEAu c\u1EA7u s\u1EF1 ki\xEAn nh\u1EABn. H\xE3y gi\u1EADt c\u1EA7n
    ngay khi phao ch\xECm xu\u1ED1ng n\u01B0\u1EDBc!"
  - "N\u1EBFu g\u1EB7p kh\xF3 kh\u0103n, h\xE3y ki\u1EC3m tra t\xFAi \u0111\u1ED3
    xem c\xF3 v\u1EADt ph\u1EA9m n\xE0o b\u1ECB b\u1ECF s\xF3t kh\xF4ng."
  - "\u0110\u1EA3o hoang ch\u1EE9a \u0111\u1EF1ng nhi\u1EC1u b\xED \u1EA9n. H\xE3y
    kh\xE1m ph\xE1 m\u1ECDi ng\xF3c ng\xE1ch \u0111\u1EC3 t\xECm manh m\u1ED1i."
